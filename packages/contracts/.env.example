# Private key of the testnet deployer wallet (0x-prefixed hex). Generate one with `cast wallet new`.
DEPLOYER_PRIVATE_KEY=
# Public address of that same deployer wallet, used to check balances and fund it from the faucet.
DEPLOYER_ADDRESS=
# Private key of a second testnet wallet that plays the borrower in script/CoreSliceLive.s.sol. Generate one with `cast wallet new`.
BORROWER_PRIVATE_KEY=
# Public address of that same borrower wallet. The script funds it from the deployer, so it needs no faucet claim.
BORROWER_ADDRESS=
# Private key of the second demo borrower in script/SeedDemo.s.sol, whose loan is left unpaid for a buyer. Generate one with `cast wallet new`.
BORROWER2_PRIVATE_KEY=
# Public address of that same second borrower. SeedDemo funds it from the deployer.
BORROWER2_ADDRESS=
# Private key of the demo buyer that purchases the second borrower's position at auction. Generate one with `cast wallet new`.
BUYER_PRIVATE_KEY=
# Public address of that same buyer. SeedDemo funds it with BTC for gas and with MUSD for the purchase.
BUYER_ADDRESS=
# Private key of the keeper that starts auctions and settles them once they are due. Generate one with `cast wallet new`.
KEEPER_PRIVATE_KEY=
# Public address of that same keeper. SeedDemo funds it from the deployer for gas, and DeployCore requires it to
# check the keeper holds no owner, guardian or treasury role.
KEEPER_ADDRESS=
# Private key of the relayer, the only wallet that can call Faucet.claim. Generate one with `cast wallet new`; it must do no other job, and DeployFaucet refuses a match with any wallet above.
RELAYER_PRIVATE_KEY=
# Public address of that same relayer. script/faucet-live.sh funds it from the deployer for gas.
RELAYER_ADDRESS=
# Record name for script/DeployCore.s.sol, written to deployments/<name>.json; blank means the chain id (31611). Wave 2 uses 31611-wave2.
DEPLOYMENT_NAME=
# Mezo sMUSD vault that parked offers wait in; blank means the chain's own (testnet 0x6f461c68B2c5492C0F5CCEc5a264d692aA7A8e16).
SAVINGS_VAULT=
# Mezo pool Router that PayDown sells rewards through; blank means the chain's own (testnet 0x9a1ff7FE3a0F69959A3fBa1F1e5ee18e1A9CD7E9).
ROUTER=
# Most a PayDown BTC sale may fall below the oracle price, in basis points: default 100 (1%), cap 300.
PAYDOWN_SLIPPAGE_BPS=100
# UnitMarket's fee on each sale of credit units, in basis points: default 25 (0.25%), cap 100.
UNIT_FEE_BPS=25
# Mezo testnet JSON-RPC endpoint (chain 31611).
MEZO_TESTNET_RPC=https://rpc.test.mezo.org
# Mezo mainnet JSON-RPC endpoint (chain 31612). The mainnet fork tests read it, if set, in place of the mezo_mainnet alias
# in foundry.toml (MEZO_TESTNET_RPC does the same for the testnet ones). If this node is down, switch to another public
# one: https://mezo.drpc.org, https://mezo-mainnet.boar.network or https://mainnet.mezo.public.validationcloud.io
MEZO_MAINNET_RPC=https://mezo-mainnet.boar.network
