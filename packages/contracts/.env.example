# Private key of the testnet deployer wallet (0x-prefixed hex). Generate one with `cast wallet new`.
DEPLOYER_PRIVATE_KEY=
# Public address of that same deployer wallet, used to check balances and fund it from the faucet.
DEPLOYER_ADDRESS=
# Private key of a second testnet wallet that plays the borrower in script/CoreSliceLive.s.sol. Generate one with `cast wallet new`.
BORROWER_PRIVATE_KEY=
# Public address of that same borrower wallet. The script funds it from the deployer, so it needs no faucet claim.
BORROWER_ADDRESS=
# Mezo testnet JSON-RPC endpoint (chain 31611).
MEZO_TESTNET_RPC=https://rpc.test.mezo.org
# Mezo mainnet JSON-RPC endpoint (chain 31612), read-only use in fork tests. drpc refuses eth_call on Mezo, so not drpc.
MEZO_MAINNET_RPC=https://jsonrpc-mezo.boar.network
