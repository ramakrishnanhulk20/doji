# Project ID from cloud.reown.com. Without it the Phone wallet row stays out of the connect window.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Cloudflare Turnstile site key, shown in the browser. It is public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key. Server only, never sent to the browser.
TURNSTILE_SECRET_KEY=

# Private key of the funded wallet that sends faucet transactions. Server only, testnet funds only.
RELAYER_PRIVATE_KEY=
